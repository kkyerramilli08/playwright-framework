# Example environment variables for running tests that interact with n8n
# Set these locally or in CI (do NOT commit real secrets)

# Webhook URL used by tests (override if necessary)
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/<your-id>

# Example application credentials for tests (replace with secure values)
SAUCE_USER=standard_user
SAUCE_PASS=your_password_here
